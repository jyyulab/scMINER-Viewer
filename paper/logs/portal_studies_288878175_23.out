# LSBATCH: User input
#!/usr/bin/env bash
#BSUB -P scminer
#BSUB -q standard
#BSUB -n 4
#BSUB -R "rusage[mem=32000]"
#BSUB -W 6:00
#BSUB -o paper/logs/portal_studies_%J_%I.out
#BSUB -e paper/logs/portal_studies_%J_%I.err
#
# LSF submission script for the portal-study benchmark.
#
# The #BSUB -q here is a fallback default. When invoked through
# paper/portal_studies_hpc.sh, the driver overrides -q per sub-array
# so the manifest's tasks distribute across queues (LSF's native
# multi-queue syntax does not actually distribute — it just picks the
# first eligible queue with capacity).
#
# Two modes, switched by whether LSB_JOBINDEX is set:
#
# 1. Array mode (preferred for the full 21-study run -- see
#    paper/portal_studies_hpc.sh). The driver writes a manifest with
#    one YAML config path per line (or one study folder per line) and
#    submits `bsub -J "name[1-N]" < this.bsub`. Each task picks line
#    $LSB_JOBINDEX of MANIFEST_FILE and benchmarks that single entry,
#    writing paper/metrics/portal_studies_<id>.tsv.
#
# 2. Single-job mode. Submit with one of:
#       CONFIGS_DIR=...   bsub < paper/portal_studies.bsub
#       STUDIES_ROOT=...  bsub < paper/portal_studies.bsub
#
# Env read by array mode:
#   MANIFEST_FILE  text file: line i is a YAML path OR a study folder
#                  (the R script auto-detects; if the line ends in
#                  .yaml/.yml it is treated as a config).
#
# Env read by single mode (use exactly one):
#   CONFIGS_DIR    folder containing the 21 YAML configs.
#   STUDIES_ROOT   folder containing one subdir per study.
#   ONLY           (optional) CSV of study IDs to restrict to.

set -euo pipefail

cd "${LS_SUBCWD:-$PWD}"
mkdir -p paper/metrics paper/logs

module load R/4.2.2-rhel8 2>/dev/null || true

if [[ -n "${LSB_JOBINDEX:-}" && "${LSB_JOBINDEX}" != "0" ]]; then
  # ---- Array mode: pick one entry by line number ------------------------
  : "${MANIFEST_FILE:?Array mode requires MANIFEST_FILE}"


#!/usr/bin/env bash
#BSUB -P scminer
#BSUB -q standard
#BSUB -n 4
#BSUB -R "rusage[mem=32000]"
#BSUB -W 6:00
#BSUB -o paper/logs/portal_studies_%J_%I.out
#BSUB -e paper/logs/portal_studies_%J_%I.err
#
# LSF submission script for the portal-study benchmark.
#
# The #BSUB -q here is a fallback default. When invoked through
# paper/portal/portal_studies_hpc.sh, the driver overrides -q per sub-array
# so the manifest's tasks distribute across queues (LSF's native
# multi-queue syntax does not actually distribute — it just picks the
# first eligible queue with capacity).
#
# Two modes, switched by whether LSB_JOBINDEX is set:
#
# 1. Array mode (preferred for the full 21-study run -- see
#    paper/portal/portal_studies_hpc.sh). The driver writes a manifest with
#    one YAML config path per line (or one study folder per line) and
#    submits `bsub -J "name[1-N]" < this.bsub`. Each task picks line
#    $LSB_JOBINDEX of MANIFEST_FILE and benchmarks that single entry,
#    writing paper/metrics/portal_studies_<id>.tsv.
#
# 2. Single-job mode. Submit with one of:
#       CONFIGS_DIR=...   bsub < paper/portal/portal_studies.bsub
#       STUDIES_ROOT=...  bsub < paper/portal/portal_studies.bsub
#
# Env read by array mode:
#   MANIFEST_FILE  text file: line i is a YAML path OR a study folder
#                  (the R script auto-detects; if the line ends in
#                  .yaml/.yml it is treated as a config).
#   MODE           (optional) 'full' (default) or 'expression-only'. When
#                  set, the R driver receives --mode $MODE and each task's
#                  per-study TSV is named portal_studies_<id>_<mode>.tsv.
#                  Used by portal_studies_compare.sh to produce a
#                  with-vs-without-TFsig comparison without clobbering.
#   OUT_ROOT       (optional) override the YAML's `output:` value. When set,
#                  the R driver receives --output-root $OUT_ROOT and writes
#                  every study's bundle / shards / graph files under
#                  $OUT_ROOT/<studyID>/. Used by the compare driver in
#                  --parallel mode so the two modes write to disjoint
#                  on-disk trees and won't race.
#
# Env read by single mode (use exactly one):
#   CONFIGS_DIR    folder containing the 21 YAML configs.
#   STUDIES_ROOT   folder containing one subdir per study.
#   ONLY           (optional) CSV of study IDs to restrict to.
#   MODE           (optional) as above; also propagated in single mode.
#   OUT_ROOT       (optional) as above; also propagated in single mode.

set -euo pipefail

cd "${LS_SUBCWD:-$PWD}"
mkdir -p paper/metrics paper/logs

module load R/4.2.2-rhel8 2>/dev/null || true
# hdf5r links against libhdf5_hl.so.10 (HDF5 1.10.x). Without an hdf5
# module the loader can't find that .so on the compute nodes. Try the
# unversioned alias first, then fall back to specific 1.10.x lines if
# your site uses versioned module names (`module avail hdf5` to list).
module load hdf5 2>/dev/null \
  || module load hdf5/1.10.7 2>/dev/null \
  || module load hdf5/1.10.8 2>/dev/null \
  || echo "[bsub] WARN: no hdf5 module loaded; hdf5r may fail to load" >&2

if [[ -n "${LSB_JOBINDEX:-}" && "${LSB_JOBINDEX}" != "0" ]]; then
  # ---- Array mode: pick one entry by line number ------------------------
  : "${MANIFEST_FILE:?Array mode requires MANIFEST_FILE}"
  line="$(sed -n "${LSB_JOBINDEX}p" "$MANIFEST_FILE")"
  if [[ -z "$line" ]]; then
    echo "[bsub] no entry at line $LSB_JOBINDEX of $MANIFEST_FILE" >&2
    exit 1
  fi

  case "$line" in
    *.yaml|*.yml|*.YAML|*.YML)
      study_id="$(basename "${line%.*}")"
      mode_flag=(--config "$line") ;;
    *)
      study_id="$(basename "$line")"
      mode_flag=(--studies-root "$(dirname "$line")" --only "$study_id") ;;
  esac

  # Benchmark cell selector: 'full' is the historical behavior; the
  # compare-orchestrator submits one array with MODE=expression-only and
  # one with MODE=full so the two TSVs sit side by side.
  RUN_MODE="${MODE:-full}"
  out_tsv="paper/metrics/portal_studies_${study_id}.tsv"
  if [[ -n "${MODE:-}" ]]; then
    out_tsv="paper/metrics/portal_studies_${study_id}_${RUN_MODE}.tsv"
  fi

  # Optional per-task output-root override (compare driver --parallel
  # mode uses this so expression-only and full modes don't race on
  # the same <output>/<studyID>/ tree).
  R_EXTRA=()
  if [[ -n "${OUT_ROOT:-}" ]]; then
    R_EXTRA+=(--output-root "$OUT_ROOT")
  fi

  echo "[bsub] array task $LSB_JOBINDEX -> $study_id ($line) mode=$RUN_MODE"
  echo "[bsub] host=$(hostname) job=${LSB_JOBID:-?}"
  if [[ -n "${OUT_ROOT:-}" ]]; then
    echo "[bsub] out-root override: $OUT_ROOT"
  fi

  Rscript paper/portal/portal_studies.R \
      "${mode_flag[@]}" \
      --mode "$RUN_MODE" \
      --out  "$out_tsv" \
      "${R_EXTRA[@]}"

  echo "[bsub] $study_id ($RUN_MODE) done"
else
  # ---- Single-job mode --------------------------------------------------
  if [[ -n "${CONFIGS_DIR:-}" ]]; then
    ARGS=(--configs-dir "$CONFIGS_DIR")
  elif [[ -n "${STUDIES_ROOT:-}" ]]; then
    ARGS=(--studies-root "$STUDIES_ROOT")
  else
    echo "[bsub] set CONFIGS_DIR=<dir> or STUDIES_ROOT=<dir>" >&2
    exit 2
  fi
  if [[ -n "${ONLY:-}" ]]; then
    ARGS+=(--only "$ONLY")
  fi
  if [[ -n "${MODE:-}" ]]; then
    ARGS+=(--mode "$MODE")
  fi
  if [[ -n "${OUT_TSV:-}" ]]; then
    ARGS+=(--out "$OUT_TSV")
  fi
  if [[ -n "${OUT_ROOT:-}" ]]; then
    ARGS+=(--output-root "$OUT_ROOT")
  fi

  echo "[bsub] single job=${LSB_JOBID:-?} host=$(hostname)"
  echo "[bsub] args: ${ARGS[*]}"

  Rscript paper/portal/portal_studies.R "${ARGS[@]}"

  echo "[bsub] done -- metrics at paper/metrics/portal_studies.tsv"
fi
